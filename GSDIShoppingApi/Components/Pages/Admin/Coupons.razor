@page "/admin/cupons"
@attribute [Authorize(Policy = "AdminOnly")]
@rendermode InteractiveServer
@inject IDbContextFactory<GSDIShoppingDbContext> DbFactory
@inject ImageUploadService ImageUpload

<PageTitle>Cupons — Painel GSDIShopping</PageTitle>

<h1>Cupons</h1>
<p class="subtitle" style="color:var(--charcoal-dim);margin-top:-8px;">
    Cupom é algo que o cliente resgata gastando pontos — sempre pertence a
    uma campanha. Diferente de promoção (ver tela Promoções), que é só um
    anúncio de desconto, sem custo em pontos.
</p>

<div class="toolbar">
    <span>@_coupons.Count cupom(ns) cadastrado(s)</span>
    @if (_campaigns.Count == 0)
    {
        <span class="error">Cadastre uma campanha antes de criar cupons.</span>
    }
    else
    {
        <button class="btn" @onclick="StartCreate">+ Novo cupom</button>
    }
</div>

@if (_form is not null)
{
    <div class="card">
        <h2>@(_form.Id is null ? "Novo cupom" : "Editar cupom")</h2>
        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="error">@_error</p>
        }
        <EditForm Model="_form" OnSubmit="Save" class="entity-form">
            <label>
                Título
                <input type="text" @bind="_form.Title" />
            </label>
            <label>
                Descrição
                <textarea rows="3" @bind="_form.Description"></textarea>
            </label>
            <label>
                Custo em pontos
                <input type="number" min="1" @bind="_form.PointsCost" />
            </label>
            <label>
                Campanha
                <select @bind="_form.CampaignId">
                    @foreach (var campaign in _campaigns)
                    {
                        <option value="@campaign.Id">@campaign.Title</option>
                    }
                </select>
            </label>
            <label>
                Validade (opcional)
                <input type="datetime-local" @bind="_form.ExpiresAt" />
            </label>
            <label>
                Imagem (opcional)
                <InputFile OnChange="OnImageSelected" accept="image/*" />
            </label>
            @if (!string.IsNullOrEmpty(_form.ImageUrl))
            {
                <img class="thumb" src="@_form.ImageUrl" alt="" />
            }
            <div class="actions">
                <button type="submit" class="btn">Salvar</button>
                <button type="button" class="btn secondary" @onclick="Cancel">Cancelar</button>
            </div>
        </EditForm>
    </div>
}

@if (_coupons.Count == 0)
{
    <p class="empty">Nenhum cupom cadastrado ainda.</p>
}
else
{
    <table>
        <thead>
            <tr><th></th><th>Título</th><th>Campanha</th><th>Pontos</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var coupon in _coupons)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(coupon.ImageUrl))
                        {
                            <img class="thumb" src="@coupon.ImageUrl" alt="" />
                        }
                    </td>
                    <td>@coupon.Title</td>
                    <td>@coupon.Campaign?.Title</td>
                    <td>@coupon.PointsCost pts</td>
                    <td>
                        <button class="btn secondary" @onclick="() => StartEdit(coupon)">Editar</button>
                        <button class="btn danger" @onclick="() => Delete(coupon.Id)">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Coupon> _coupons = new();
    private List<Campaign> _campaigns = new();
    private CouponForm? _form;
    private string? _error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _campaigns = await db.Campaigns.OrderBy(c => c.Title).ToListAsync();
        _coupons = await db.Coupons.Include(c => c.Campaign).OrderBy(c => c.ExpiresAt).ToListAsync();
    }

    private void StartCreate()
    {
        _form = new CouponForm { CampaignId = _campaigns[0].Id, PointsCost = 100 };
        _error = null;
    }

    private void StartEdit(Coupon coupon)
    {
        _form = new CouponForm
        {
            Id = coupon.Id,
            Title = coupon.Title,
            Description = coupon.Description,
            PointsCost = coupon.PointsCost,
            CampaignId = coupon.CampaignId,
            ExpiresAt = coupon.ExpiresAt,
            ImageUrl = coupon.ImageUrl,
        };
        _error = null;
    }

    private void Cancel()
    {
        _form = null;
        _error = null;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        if (_form is null) return;
        _form.ImageUrl = await ImageUpload.SaveAsync(e.File, "cupons", CancellationToken.None);
    }

    private async Task Save()
    {
        if (_form is null) return;

        if (string.IsNullOrWhiteSpace(_form.Title))
        {
            _error = "Título do cupom é obrigatório.";
            return;
        }
        if (_form.PointsCost <= 0)
        {
            _error = "Custo em pontos precisa ser maior que zero.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var campaignExists = await db.Campaigns.AnyAsync(c => c.Id == _form.CampaignId);
        if (!campaignExists)
        {
            _error = "Selecione uma campanha válida.";
            return;
        }

        if (_form.Id is null)
        {
            db.Coupons.Add(new Coupon
            {
                Title = _form.Title.Trim(),
                Description = _form.Description?.Trim() ?? string.Empty,
                PointsCost = _form.PointsCost,
                CampaignId = _form.CampaignId,
                ExpiresAt = _form.ExpiresAt,
                ImageUrl = _form.ImageUrl,
            });
        }
        else
        {
            var coupon = await db.Coupons.FindAsync(_form.Id.Value);
            if (coupon is null) { _error = "Cupom não encontrado."; return; }
            coupon.Title = _form.Title.Trim();
            coupon.Description = _form.Description?.Trim() ?? string.Empty;
            coupon.PointsCost = _form.PointsCost;
            coupon.CampaignId = _form.CampaignId;
            coupon.ExpiresAt = _form.ExpiresAt;
            coupon.ImageUrl = _form.ImageUrl;
        }

        await db.SaveChangesAsync();
        _form = null;
        _error = null;
        await Load();
    }

    private async Task Delete(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var coupon = await db.Coupons.FindAsync(id);
        if (coupon is not null)
        {
            db.Coupons.Remove(coupon);
            await db.SaveChangesAsync();
        }
        await Load();
    }

    private class CouponForm
    {
        public int? Id { get; set; }
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public int PointsCost { get; set; } = 100;
        public int CampaignId { get; set; }
        public DateTime? ExpiresAt { get; set; }
        public string? ImageUrl { get; set; }
    }
}
